# Systemd service file for JohnPod
# Copy this file to /etc/systemd/system/johnpod.service
# Update paths and user as needed

[Unit]
Description=JohnPod Discord Bot
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/JohnPod
ExecStart=/usr/bin/node /home/ubuntu/JohnPod/dist/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/JohnPod/.env

# Logging (uses journald, view with: journalctl -u johnpod)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=johnpod

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/JohnPod

[Install]
WantedBy=multi-user.target